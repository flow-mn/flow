<?xml version="1.0" encoding="utf-8"?>
<!--
  Static widget-picker preview (android:previewLayout), used on Android 12-14
  and until the generated preview (Summary.providePreview) is published.
  The generated preview scales with the picker's box (full size on Pixel,
  ~0.88 on One UI). This copies that without code: the cards are the widget's
  natural height (12 + 19 + 4 + 28 + 12dp) and every row carries its height as
  a weight, so in a shorter box LinearLayout shrinks them in proportion; the
  amount auto-sizes to its row, up to the widget's 20sp.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:layout_gravity="center_vertical"
  android:background="@drawable/preview_widget_bg"
  android:orientation="horizontal" android:padding="8dp">
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp"
    android:background="@drawable/preview_card" android:orientation="vertical"
    android:paddingStart="10dp" android:paddingEnd="10dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="12dp" android:layout_weight="12" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="19dp" android:layout_weight="19" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:textAppearance="@style/Glance.AppWidget.TextAppearance.Normal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_preview_income" android:textSize="12sp" android:textColor="@color/preview_on_surface_variant" android:maxLines="1" />
      <ImageView android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="4dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/ic_arrow_down_forward" android:tint="@color/income_green" tools:ignore="UseAppTint" android:importantForAccessibility="no" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_weight="4" />
    <TextView android:textAppearance="@style/Glance.AppWidget.TextAppearance.Bold" android:layout_width="match_parent" android:layout_height="28dp" android:layout_weight="28"
      android:text="@string/widget_preview_amount_income" android:textColor="@color/preview_on_surface" android:maxLines="1" android:gravity="center_vertical|start"
      android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="0.5sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="12dp" android:layout_weight="12" />
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:background="@drawable/preview_card" android:orientation="vertical"
    android:paddingStart="10dp" android:paddingEnd="10dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="12dp" android:layout_weight="12" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="19dp" android:layout_weight="19" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:textAppearance="@style/Glance.AppWidget.TextAppearance.Normal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_preview_expense" android:textSize="12sp" android:textColor="@color/preview_on_surface_variant" android:maxLines="1" />
      <ImageView android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="4dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/ic_arrow_up_forward" android:tint="@color/expense_red" tools:ignore="UseAppTint" android:importantForAccessibility="no" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_weight="4" />
    <TextView android:textAppearance="@style/Glance.AppWidget.TextAppearance.Bold" android:layout_width="match_parent" android:layout_height="28dp" android:layout_weight="28"
      android:text="@string/widget_preview_amount_expense" android:textColor="@color/preview_on_surface" android:maxLines="1" android:gravity="center_vertical|start"
      android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="0.5sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="12dp" android:layout_weight="12" />
  </LinearLayout>
</LinearLayout>
</FrameLayout>
