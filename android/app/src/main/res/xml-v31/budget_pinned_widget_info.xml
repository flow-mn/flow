<!--
  API 31+ variant. `reconfigurable` matters more here than on the roll-up:
  changing which budget a widget follows should not require deleting it.
-->
<appwidget-provider
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:label="@string/budget_pinned_widget_label"
  android:description="@string/budget_pinned_widget_description"
  android:minWidth="110dp"
  android:minHeight="110dp"
  android:targetCellWidth="2"
  android:targetCellHeight="2"
  android:resizeMode="horizontal|vertical"
  android:widgetFeatures="reconfigurable"
  android:configure="mn.flow.flow.glance.BudgetPinnedConfigActivity"
  android:initialLayout="@layout/glance_default_loading_layout">
</appwidget-provider>
